rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /participantes/{id} {
      allow read: if true;
      allow create, update: if id in ['angel','diego','frances','jasmin','javier','jhon','kevin','linda','mayra','sebastian','silvana','stefany']
        && request.resource.data.keys().hasOnly(['name','area','avatar','gustos','opciones','updatedAt']);
      allow delete: if false;
    }
  }
}
